{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<h1>{{ collection.title }}</h1>
<h2>{{ collection.products_count }} products found</h2>

<div class="collection-products">
  {% paginate collection.products by 12 %}
    {% render 'product-card' for collection.products as product, show_vendor: false, lazy_load: true %}
    {% if paginate.pages > 1 %}
      {{ paginate | default_pagination }}
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(500px, 1fr));
    gap: 20px;
  }
  @media (max-width: 768px) {
    .collection-products {
      grid-template-columns: repeat(2, minmax(500, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
