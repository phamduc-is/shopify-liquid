<div class="trust-badges">
  {% for block in section.blocks %}
    <div class="trust-badge" {{ block.shopify_attributes }}>
      {% case block.type %}
        {% when 'icon_with_text' %}
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
      {% endcase %}
    </div>
  {% endfor %}
</div>
{% schema %}
{
  "name": "Trust Badges",
  "blocks": [
    {
      "type": "icon_with_text",
      "name": "Icon with text",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Miễn phí vận chuyển" },
        { "type": "textarea", "id": "text", "label": "Mô tả", "default": "Cho đơn hàng trên 500k" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "icon_with_text", "settings": { "heading": "Miễn phí vận chuyển" } },
        { "type": "icon_with_text", "settings": { "heading": "Đổi trả 30 ngày" } }
      ]
    }
  ]
}
{% endschema %}
