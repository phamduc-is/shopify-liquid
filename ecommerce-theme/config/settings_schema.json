[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "archivo_black_n4",
        "label": "t:general.heading"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#000000",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "text_secondary_color",
        "default": "#6C7275",
        "label": "t:labels.text_secondary"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E8E8E8",
        "label": "t:labels.border"
      },
      {
        "type": "color",
        "id": "surface_secondary_color",
        "default": "#F0F0F0",
        "label": "t:labels.surface_secondary"
      },
      {
        "type": "header",
        "content": "t:general.product"
      },
      {
        "type": "color",
        "id": "sale_badge_background",
        "default": "#FFE1DD",
        "label": "t:labels.sale_badge_background"
      },
      {
        "type": "color",
        "id": "sale_badge_text",
        "default": "#FF3333",
        "label": "t:labels.sale_badge_text"
      },
      {
        "type": "color",
        "id": "rating_star_color",
        "default": "#FFC633",
        "label": "t:labels.rating_star"
      },
      {
        "type": "color",
