{% comment %}
  TODO (Liquid động, làm sau):
  - Nav "Shop" cần dropdown menu thật (linklist) khi wiring dynamic
  - Cart icon cần badge số lượng thật: cart.item_count
  - Account icon cần shopify-account/routes.account_url thật
  - Announcement bar text/link lấy từ setting
  TODO (hành vi, chưa phải bước này):
  - Nút hamburger (.header__menu-toggle) mở mobile nav — chưa có JS
  - Nút X (.announcement-bar__close) đóng announcement bar — chưa có JS
{% endcomment %}

<div class="announcement-bar">
  <div class="announcement-bar__inner container">
    <p class="announcement-bar__text">
      Sign up and get 20% off to your first order.
      <a href="#" class="announcement-bar__link">Sign Up Now</a>
    </p>
    <button type="button" class="announcement-bar__close" aria-label="Đóng thông báo">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
  </div>
</div>

<header class="header">
  <div class="header__inner container">
    <button type="button" class="header__menu-toggle" aria-label="Mở menu">
      {{ 'icon-menu.svg' | inline_asset_content }}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">SHOP.CO</a>

    <nav class="header__nav">
      <button type="button" class="header__nav-link header__nav-link--dropdown">
        Shop
        {{ 'icon-chevron-down.svg' | inline_asset_content }}
      </button>
      <a href="#" class="header__nav-link">On Sale</a>
      <a href="#" class="header__nav-link">New Arrivals</a>
      <a href="#" class="header__nav-link">Brands</a>
    </nav>

    {% comment %}
      <div class="header__search">
        {{ 'icon-search.svg' | inline_asset_content }}
        <input type="search" class="header__search-input" placeholder="Search for products...">
      </div>
    {% endcomment %}

    <form action="{{ routes.search_url }}" method="get" role="search" class="header__search">
      {{ 'icon-search.svg' | inline_asset_content }}
      <input
        type="search"
        name="q"
        class="header__search-input"
        placeholder="Search for products..."
        value="{{ search.terms | escape }}"
      >
    </form>

    <div class="header__icons">
      <button type="button" class="header__icon-button header__icon-button--search" aria-label="Tìm kiếm">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
      <a href="{{ routes.cart_url }}" class="header__icon-button">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <a href="{{ routes.account_url }}" class="header__icon-button">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>
