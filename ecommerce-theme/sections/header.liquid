<div class="announcement-bar full-width">
  <div class="announcement-bar__inner container-fullwidth">
    <p class="announcement-bar__text">
      {{ section.settings.announcement_text }}
      {% if section.settings.announcement_link_url != blank %}
        <a href="{{ section.settings.announcement_link_url }}" class="announcement-bar__link">
          {{ section.settings.announcement_link_text }}
        </a>
      {% endif %}
    </p>
    <button type="button" class="announcement-bar__close" aria-label="Đóng thông báo">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
  </div>
</div>

<header class="header full-width">
  <div class="header__inner container">
    <button type="button" class="header__menu-toggle" aria-label="Mở menu">
      {{ 'icon-menu.svg' | inline_asset_content }}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">SHOP.CO</a>

    <nav class="header__nav">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <button type="button" class="header__nav-link header__nav-link--dropdown">
            {{ link.title }}
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          </button>
        {% else %}
          <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <form action="{{ routes.search_url }}" method="get" role="search" class="header__search">
      {{ 'icon-search.svg' | inline_asset_content }}
      <input
        type="search"
        name="q"
        class="header__search-input"
        placeholder="Search for products..."
        value="{{ search.terms | escape }}"
      >
    </form>

    <div class="header__icons">
      <button type="button" class="header__icon-button header__icon-button--search" aria-label="Tìm kiếm">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
      <a href="{{ routes.cart_url }}" class="header__icon-button">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <a href="{{ routes.account_url }}" class="header__icon-button">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <dialog class="mobile-nav" scroll-lock aria-label="Menu">
    <button type="button" class="mobile-nav__close" aria-label="Đóng menu">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <nav class="mobile-nav__links">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <button type="button" class="header__nav-link header__nav-link--dropdown">
            {{ link.title }}
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          </button>
        {% else %}
          <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </dialog>

  <dialog class="search-popup" scroll-lock aria-label="Tìm kiếm">
    <button type="button" class="search-popup__close" aria-label="Đóng tìm kiếm">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-popup__form">
      {{ 'icon-search.svg' | inline_asset_content }}
      <input
        type="search"
        name="q"
        class="search-popup__input"
        placeholder="Search for products..."
        value="{{ search.terms | escape }}"
      >
    </form>
  </dialog>
</header>

{% javascript %}
  // Header — announcement bar, mobile nav, search popup.
  //
  // Bọc IIFE vì Shopify gộp mọi javascript tag của theme vào chung 1 file: biến
  // khai báo ở top-level sẽ dùng chung scope với mọi section khác, trùng tên là
  // SyntaxError và chết cả bundle.
  (function () {
    // Mobile nav và search popup mở/đóng y hệt nhau nên dùng chung 1 hàm.
    const initDialog = (openButton, dialog, closeButton) => {
      if (!dialog) return;

      openButton?.addEventListener('click', () => dialog.showModal());
      closeButton?.addEventListener('click', () => dialog.close());

      // Click trúng chính <dialog> tức là click vào vùng backdrop, không phải nội dung.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    };

    // root là <div class="shopify-section"> của header chứ không phải .header,
    // vì .announcement-bar là anh em của <header> chứ không nằm trong nó.
    const initHeader = (root) => {
      const announcementBar = root.querySelector('.announcement-bar');

      root.querySelector('.announcement-bar__close')?.addEventListener('click', () => {
        announcementBar?.remove();
      });

      initDialog(
        root.querySelector('.header__menu-toggle'),
        root.querySelector('.mobile-nav'),
        root.querySelector('.mobile-nav__close')
      );

      initDialog(
        root.querySelector('.header__icon-button--search'),
        root.querySelector('.search-popup'),
        root.querySelector('.search-popup__close')
      );
    };

    // Đi ngược từ .header lên section wrapper: id của section trong header-group
    // do Shopify sinh ra nên không hardcode được.
    const initFromHeader = (header) => {
      initHeader(header.closest('.shopify-section') ?? document);
    };

    document.querySelectorAll('.header').forEach(initFromHeader);

    // Theme editor thay lại DOM của section mà không reload trang.
    document.addEventListener('shopify:section:load', (event) => {
      event.target.querySelectorAll('.header').forEach(initFromHeader);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "announcement content",
      "default": "Sign up and get 20% off to your first order."
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Link text",
      "default": "Sign Up Now"
    }
  ]
}
{% endschema %}
