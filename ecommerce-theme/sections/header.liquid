<div class="announcement-bar full-width">
  <div class="announcement-bar__inner container-fullwidth">
    <p class="announcement-bar__text">
      {{ section.settings.announcement_text }}
      {% if section.settings.announcement_link_url != blank %}
        <a href="{{ section.settings.announcement_link_url }}" class="announcement-bar__link">
          {{ section.settings.announcement_link_text }}
        </a>
      {% endif %}
    </p>
    <button type="button" class="announcement-bar__close" aria-label="Đóng thông báo">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
  </div>
</div>

<header class="header full-width">
  <div class="header__inner container">
    <button type="button" class="header__menu-toggle" aria-label="Mở menu">
      {{ 'icon-menu.svg' | inline_asset_content }}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">SHOP.CO</a>

    <nav class="header__nav">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <button type="button" class="header__nav-link header__nav-link--dropdown">
            {{ link.title }}
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          </button>
        {% else %}
          <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <form action="{{ routes.search_url }}" method="get" role="search" class="header__search">
      {{ 'icon-search.svg' | inline_asset_content }}
      <input
        type="search"
        name="q"
        class="header__search-input"
        placeholder="Search for products..."
        value="{{ search.terms | escape }}"
      >
    </form>

    <div class="header__icons">
      <button type="button" class="header__icon-button header__icon-button--search" aria-label="Tìm kiếm">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
      <a href="{{ routes.cart_url }}" class="header__icon-button">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <a href="{{ routes.account_url }}" class="header__icon-button">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <dialog class="mobile-nav" scroll-lock aria-label="Menu">
    <button type="button" class="mobile-nav__close" aria-label="Đóng menu">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <nav class="mobile-nav__links">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <button type="button" class="header__nav-link header__nav-link--dropdown">
            {{ link.title }}
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          </button>
        {% else %}
          <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </dialog>
</header>

{% javascript %}
  const announcementCloseButton = document.querySelector('.announcement-bar__close');

  announcementCloseButton?.addEventListener('click', () => {
    document.querySelector('.announcement-bar')?.remove();
  });

  // hamburger btn
  const menuToggleButton = document.querySelector('.header__menu-toggle');
  const mobileNav = document.querySelector('.mobile-nav');
  const mobileNavCloseButton = document.querySelector('.mobile-nav__close');

  menuToggleButton?.addEventListener('click', () => {
    mobileNav?.showModal();
  });

  mobileNavCloseButton?.addEventListener('click', () => {
    mobileNav?.close();
  });

  mobileNav?.addEventListener('click', (event) => {
    if (event.target === mobileNav) {
      mobileNav.close();
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "announcement content",
      "default": "Sign up and get 20% off to your first order."
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Link text",
      "default": "Sign Up Now"
    }
  ]
}
{% endschema %}
